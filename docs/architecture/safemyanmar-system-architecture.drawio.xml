        <mxCell id="bt" value="SafeMyanmar - BLE SOS Detailed Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="b1"><mxGeometry x="470" y="20" width="960" height="40" as="geometry"/></mxCell>
        <mxCell id="bst" value="Connectionless advertising | No pairing | No internet required | No delivery acknowledgement" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontColor=#4B5563;" vertex="1" parent="b1"><mxGeometry x="420" y="62" width="1060" height="28" as="geometry"/></mxCell>

        <mxCell id="senderBox" value="SENDER DEVICE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#4A86E8;fontStyle=1;fontSize=14;" vertex="1" parent="b1"><mxGeometry x="30" y="110" width="730" height="900" as="geometry"/></mxCell>
        <mxCell id="radioBox" value="BLE RADIO" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#FCE4D6;swimlaneFillColor=#FFF9F5;strokeColor=#ED7D31;fontStyle=1;fontSize=14;" vertex="1" parent="b1"><mxGeometry x="790" y="110" width="240" height="900" as="geometry"/></mxCell>
        <mxCell id="receiverBox" value="RECEIVER DEVICE" style="swimlane;html=1;startSize=34;rounded=1;fillColor=#E2F0D9;swimlaneFillColor=#F7FCF4;strokeColor=#70AD47;fontStyle=1;fontSize=14;" vertex="1" parent="b1"><mxGeometry x="1060" y="110" width="800" height="900" as="geometry"/></mxCell>

        <mxCell id="activate" value="&lt;b&gt;1. Explicit activation&lt;/b&gt;&lt;br&gt;Enable nearby sharing&lt;br&gt;Review exact BLE preview&lt;br&gt;Hold or accessible two-step confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="70" y="175" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="saveDraft" value="&lt;b&gt;2. Save secure SOS draft&lt;/b&gt;&lt;br&gt;Optional current/last-known location&lt;br&gt;Alias: max 16 UTF-8 bytes&lt;br&gt;Message: max 48 UTF-8 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="430" y="175" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="codec" value="&lt;b&gt;4. Encode frames&lt;/b&gt;&lt;br&gt;Base v3: 26 bytes&lt;br&gt;Optional v4 metadata fragments&lt;br&gt;CRC-16 per frame&lt;br&gt;TTL normally 10 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="70" y="350" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;b&gt;3. Create event identity&lt;/b&gt;&lt;br&gt;Daily random 4-byte sender token&lt;br&gt;2-byte event sequence&lt;br&gt;ID = A5 5A + token + sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="430" y="350" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="permission" value="&lt;b&gt;5. Permission gate&lt;/b&gt;&lt;br&gt;Android 12+: ADVERTISE + CONNECT&lt;br&gt;Android 13+: notifications&lt;br&gt;Bluetooth enabled" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="b1"><mxGeometry x="70" y="540" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="bridge" value="&lt;b&gt;6. Native bridge validation&lt;/b&gt;&lt;br&gt;Validates every frame&lt;br&gt;One shared event ID; max 12 frames&lt;br&gt;Registers self-event suppression&lt;br&gt;5-second start timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="430" y="550" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="broadcast" value="&lt;b&gt;7. Broadcast foreground service&lt;/b&gt;&lt;br&gt;Non-connectable, low-latency, high TX power&lt;br&gt;Rotates frames every 500 ms&lt;br&gt;Visible notification and Stop action&lt;br&gt;Auto-stop after up to 10 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="250" y="755" width="320" height="135" as="geometry"/></mxCell>
        <mxCell id="senderFail" value="Failure: unsupported hardware, Bluetooth disabled, permission denial, invalid frames, timeout, or native start failure. The saved draft remains available for an explicit retry." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="b1"><mxGeometry x="90" y="925" width="560" height="60" as="geometry"/></mxCell>

        <mxCell id="air" value="&lt;b&gt;Manufacturer data 0xFFFF&lt;/b&gt;&lt;br&gt;Base v3 frame&lt;br&gt;+ rotating v4 metadata frames&lt;br&gt;&lt;br&gt;&lt;b&gt;Not encrypted or authenticated over the air&lt;/b&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="820" y="390" width="180" height="170" as="geometry"/></mxCell>
        <mxCell id="radioNote" value="Range and delivery depend on device hardware, orientation, interference, Android policy, and receipt of rotating frames." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="b1"><mxGeometry x="815" y="665" width="190" height="105" as="geometry"/></mxCell>

        <mxCell id="fgScan" value="&lt;b&gt;Foreground scan&lt;/b&gt;&lt;br&gt;Explicit receive opt-in&lt;br&gt;Low-latency scan&lt;br&gt;Payload + RSSI via EventChannel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="1100" y="180" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="dartController" value="&lt;b&gt;Dart receive controller&lt;/b&gt;&lt;br&gt;Decode and reassemble metadata&lt;br&gt;Reject malformed/future/expired frames&lt;br&gt;Deduplicate and replace older sender event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="1370" y="180" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="nearbyUi" value="&lt;b&gt;Nearby SOS UI / Map&lt;/b&gt;&lt;br&gt;Unverified peer event&lt;br&gt;Alias/message when complete, location status, time, battery, RSSI, TTL, protocol, hops&lt;br&gt;Optional user-requested route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="b1"><mxGeometry x="1640" y="170" width="180" height="130" as="geometry"/></mxCell>

        <mxCell id="bgScan" value="&lt;b&gt;Background scan service&lt;/b&gt;&lt;br&gt;Separate explicit opt-in&lt;br&gt;Low-power scan&lt;br&gt;Connected-device foreground service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="1100" y="440" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="validator" value="&lt;b&gt;Native validator&lt;/b&gt;&lt;br&gt;Marker, version, length, CRC&lt;br&gt;TTL, timestamp, hop count&lt;br&gt;Coordinates, battery, metadata fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=11;" vertex="1" parent="b1"><mxGeometry x="1370" y="440" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="store" value="&lt;b&gt;Encrypted event store&lt;/b&gt;&lt;br&gt;AES-256-GCM values&lt;br&gt;Android Keystore key&lt;br&gt;Max 64 active events&lt;br&gt;Sender sequence high-water" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="b1"><mxGeometry x="1640" y="425" width="180" height="140" as="geometry"/></mxCell>
