# Flutter compile-time contract. Flutter does not load this file; pass these as
# --dart-define values. The public Mapbox token is embedded in the app and is not
# a secret; restrict it by application/package and allowed APIs.
API_BASE_URL=http://localhost:8000
MAPBOX_PUBLIC_ACCESS_TOKEN=pk.replace_with_restricted_public_token

# Backend runtime contract. Copy backend/.env.example to backend/.env.
DATABASE_URL=postgresql+psycopg://safemyanmar_dev:safemyanmar_dev_password@localhost:5432/safemyanmar
ENVIRONMENT=development
USGS_FEED_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_LOOKBACK_DAYS=3650
PROVIDER_TIMEOUT_SECONDS=10.0
REFRESH_MINIMUM_SECONDS=60
CURRENT_MAX_AGE_SECONDS=300
ENABLE_SIMULATION_DATA=false
ENABLE_SIMULATION_ANALYSIS=false
NAVIGATION_DATA_PATH=SafeMyanmar_Yangon_2026-08-17
# Public OSM/Overpass endpoint for mapped environment geometry. OSM-derived
# features require OpenStreetMap attribution in any user-facing surface.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OpenTopoData ASTER30m by default; this is terrain elevation, not a flood
# forecast. Configure a compatible approved DEM/Copernicus-derived service when
# the deployment has one.
ELEVATION_API_URL=https://api.opentopodata.org/v1/aster30m
# Environment observations are held only in a bounded process-local coarse cache
# and may be served with an explicit stale warning after an upstream failure.
# Backend-only secret required to generate real or simulation route alternatives
# when a verified/selected destination is requested. Never pass this token to
# Flutter; an unset or invalid value leaves routing unavailable.
MAPBOX_DIRECTIONS_ACCESS_TOKEN=
