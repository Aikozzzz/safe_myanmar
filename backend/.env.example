DATABASE_URL=postgresql+psycopg://safemyanmar_dev:safemyanmar_dev_password@localhost:5432/safemyanmar
ENVIRONMENT=development
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
PROVIDER_TIMEOUT_SECONDS=10.0
REFRESH_MINIMUM_SECONDS=60
CURRENT_MAX_AGE_SECONDS=300
ENABLE_SIMULATION_DATA=false
ENABLE_SIMULATION_ANALYSIS=false
NAVIGATION_DATA_PATH=SafeMyanmar_Yangon_2026-08-17
# Public OSM/Overpass endpoint used for mapped building, open-space, obstacle,
# power, and flood-water geometry. Review provider terms and availability before
# deploying; OSM-derived geometry requires visible OpenStreetMap attribution.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Default terrain source is OpenTopoData's ASTER30m endpoint. This is terrain
# elevation, not a flood forecast; replace it with a compatible approved DEM or
# Copernicus-derived service when your deployment provides one.
ELEVATION_API_URL=https://api.opentopodata.org/v1/aster30m
# Environment observations use a bounded process-local coarse-area cache. Cache
# entries are not persisted; live failures may return an explicitly stale
# observation. Exact user coordinates are not logged or stored by SafeMyanmar,
# although configured upstream GIS requests receive the requested location.
# Backend-only secret required to generate real or simulation route alternatives
# when a verified/selected destination is requested. An unset or invalid value
# leaves routing unavailable; never expose it to Flutter.
MAPBOX_DIRECTIONS_ACCESS_TOKEN=
